# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never put real keys in this file.

# Supabase (Project Settings → API Keys).
# These two are safe in the browser; the database is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini (Google AI Studio). Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# AI model names (check exact names in Google AI Studio).
AI_MODEL_DEFAULT=
AI_MODEL_FALLBACK=
